{
  "name": "@kubohiroya/turbowarp-plus-editor-guide",
  "version": "0.1.0",
  "description": "Project-driven GUI guides for TurboWarp Plus Editor",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubohiroya/turbowarp-plus-editor-guide.git"
  },
  "files": [
    "dist",
    "src",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.mjs",
      "require": "./dist/cjs/host.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.mjs",
      "require": "./dist/cjs/extension.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test:browser": "node --test test/*.browser.ts",
    "test:editor": "node --test test/*.integration.ts",
    "test:distribution": "node --test test/distribution.check.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <19",
    "react-dom": ">=16.8.0 <19"
  },
  "dependencies": {
    "react-joyride": "3.2.0"
  },
  "devDependencies": {
    "@kubohiroya/turbowarp-runtime-adapter": "0.6.0",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.10.1",
    "@types/react": "16.14.68",
    "@types/react-dom": "16.9.25",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "6.0.3"
  }
}
